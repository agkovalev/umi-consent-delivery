# Copy to /etc/umi-consent-delivery/backup.env with mode 0600.
# Leave both empty for local-only backups. Set both when an offsite SSH server is ready.
# The SSH alias must use a pinned host key and noninteractive key authentication.
BACKUP_SSH_HOST=
BACKUP_REMOTE_DIR=

# Paths must stay under /srv/umi-consent-delivery for the isolated ops container.
BACKUP_REPO_ROOT=/opt/umi-consent-delivery
BACKUP_DATA_DIR=/srv/umi-consent-delivery/data
BACKUP_ROOT=/srv/umi-consent-delivery/backups
BACKUP_PUBLIC_KEY=/etc/umi-consent-delivery/public.pem
BACKUP_KEEP_DAILY=14
